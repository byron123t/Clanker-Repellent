# Copy to .env and replace every angle-bracket placeholder.
GUARDRAIL_SSH_TARGET=<ssh-user>@<server-address>
GUARDRAIL_REMOTE_HOST=<remote-loopback-host>

GUARDRAIL_GLM_LOCAL_PORT=<local-port>
GUARDRAIL_GLM_REMOTE_PORT=<remote-port>
GUARDRAIL_GLM_BASE_URL=<loopback-openai-base-url>

GUARDRAIL_QWEN36_LOCAL_PORT=<local-port>
GUARDRAIL_QWEN36_REMOTE_PORT=<remote-port>
GUARDRAIL_QWEN36_BASE_URL=<loopback-openai-base-url>

GUARDRAIL_QWEN3_LOCAL_PORT=<local-port>
GUARDRAIL_QWEN3_REMOTE_PORT=<remote-port>
GUARDRAIL_QWEN3_BASE_URL=<loopback-openai-base-url>

# Optional direct gateway configuration.
GUARDRAIL_BASE_URL=<https-openai-base-url>
GUARDRAIL_API_KEY=<api-key>
# GUARDRAIL_CA_CERT=<relative-or-absolute-certificate-path>
