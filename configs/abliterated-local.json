{
  "schema_version": "1.0",
  "ssh": {
    "target": "${GUARDRAIL_SSH_TARGET}",
    "startup_timeout_seconds": 15,
    "forwards": [
      {
        "local_port": "${REPEL_LOCAL_PORT}",
        "remote_host": "${GUARDRAIL_REMOTE_HOST}",
        "remote_port": "${REPEL_REMOTE_PORT}"
      }
    ]
  },
  "endpoint": {
    "base_url": "${REPEL_BASE_URL}",
    "timeout_seconds": 180,
    "health_timeout_seconds": 600,
    "minimum_max_tokens": 8192,
    "tool_mode": "prompt_json"
  }
}
